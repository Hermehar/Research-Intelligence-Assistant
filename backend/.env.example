# ---- Database ----
DATABASE_URL=postgresql+psycopg://researcher:changeme@localhost:5432/research_assistant

# ---- File storage ----
# Where validated PDFs are stored (UUID-named). Created on startup if missing.
PDF_STORAGE_DIR=./data/pdfs
MAX_PDF_MB=50

# ---- LLM (vLLM, OpenAI-compatible endpoint) ----
# Point this at your vLLM server. Any OpenAI-compatible endpoint works,
# which lets you develop against a hosted model before the A100 is set up.
LLM_BASE_URL=http://localhost:8001/v1
LLM_MODEL=Qwen/Qwen2.5-32B-Instruct
LLM_API_KEY=not-needed-for-local-vllm
LLM_TIMEOUT_S=120

# ---- Embeddings (optional in Phase 1) ----
# Leave EMBEDDINGS_ENABLED=false to store chunks without vectors for now.
# Set true and point at an OpenAI-compatible embeddings endpoint to enable
# semantic search (Phase 3). EMBEDDING_DIM must match your model.
EMBEDDINGS_ENABLED=false
EMBEDDINGS_BASE_URL=http://localhost:8002/v1
EMBEDDINGS_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024

# ---- Security ----
# Localhost-only for now: auth is OPTIONAL. Set REQUIRE_API_KEY=true and a
# strong API_KEY before exposing the backend on any network. (See security-model.md)
REQUIRE_API_KEY=false
API_KEY=

# ---- CORS ----
# The extension origin(s) allowed to call the backend.
ALLOWED_ORIGINS=chrome-extension://*
